ENV=production
DATABASE_URL=postgresql+psycopg2://user:password@host/database?sslmode=require
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2

JWT_SECRET=replace-with-a-long-random-secret
APP_URL=https://your-app.workers.dev
ALLOWED_ORIGINS=https://your-app.workers.dev

BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=KitaStock

CRON_SECRET=replace-with-a-long-random-secret
